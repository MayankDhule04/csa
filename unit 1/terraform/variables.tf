# variables.tf
# ---------------------------------------------------------------------------
# All configurable inputs for the project. Every value has a sensible default
# so the project can be deployed out-of-the-box, but each can be overridden in
# terraform.tfvars without editing the code.
# ---------------------------------------------------------------------------

# ------------------------------- General ----------------------------------

variable "aws_region" {
  description = "AWS region to deploy all resources into."
  type        = string
  default     = "us-east-1"
}

variable "project_name" {
  description = "Short project identifier used for naming and tagging resources."
  type        = string
  default     = "cloudsec-pbl"
}

variable "environment" {
  description = "Deployment environment (e.g. dev, test, prod). Used in naming/tags."
  type        = string
  default     = "dev"
}

variable "owner" {
  description = "Owner tag applied to resources (student name or team)."
  type        = string
  default     = "student"
}

# ------------------------------- Networking --------------------------------

variable "vpc_cidr" {
  description = "CIDR block for the VPC. /16 gives plenty of room for all tiers."
  type        = string
  default     = "10.0.0.0/16"

  validation {
    condition     = can(cidrhost(var.vpc_cidr, 0))
    error_message = "vpc_cidr must be a valid IPv4 CIDR block."
  }
}

variable "az_count" {
  description = "Number of Availability Zones to spread subnets across (2 = HA, cost-appropriate for a student project)."
  type        = number
  default     = 2

  validation {
    condition     = var.az_count >= 2 && var.az_count <= 3
    error_message = "az_count must be 2 or 3 to keep the demo highly available but low cost."
  }
}

variable "single_nat_gateway" {
  description = "If true, deploy a single shared NAT Gateway (cheaper). If false, one per AZ (more resilient, more costly)."
  type        = bool
  default     = true
}

# ------------------------------- Compute -----------------------------------

variable "app_instance_type" {
  description = "EC2 instance type for the application tier. t3.micro is low cost and free-tier friendly in most regions."
  type        = string
  default     = "t3.micro"
}

variable "app_desired_capacity" {
  description = "Desired number of application-tier EC2 instances in the Auto Scaling Group."
  type        = number
  default     = 2
}

variable "app_min_size" {
  description = "Minimum number of application-tier instances."
  type        = number
  default     = 2
}

variable "app_max_size" {
  description = "Maximum number of application-tier instances."
  type        = number
  default     = 2
}

# ------------------------------- Database ----------------------------------

variable "db_engine_version" {
  description = "MySQL engine version for Amazon RDS."
  type        = string
  default     = "8.0"
}

variable "db_instance_class" {
  description = "RDS instance class. db.t3.micro is low cost and free-tier friendly in most regions."
  type        = string
  default     = "db.t3.micro"
}

variable "db_allocated_storage" {
  description = "Allocated storage for RDS in GiB."
  type        = number
  default     = 20
}

variable "db_name" {
  description = "Initial database name created inside the RDS instance."
  type        = string
  default     = "appdb"
}

variable "db_username" {
  description = "Master username for the RDS instance. The password is generated by Terraform (random_password) and never hardcoded."
  type        = string
  default     = "appadmin"
}

variable "db_multi_az" {
  description = "Enable RDS Multi-AZ. Defaults to false to control cost for a student project; set true to demonstrate HA at the DB tier."
  type        = bool
  default     = false
}

# ------------------------------- Access ------------------------------------

variable "allowed_web_cidr" {
  description = "CIDR allowed to reach the public load balancer on HTTP. Defaults to the whole internet (public web tier). Restrict to your IP/32 for a tighter demo."
  type        = string
  default     = "0.0.0.0/0"
}
