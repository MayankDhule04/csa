# database.tf
# ---------------------------------------------------------------------------
# The database tier: an Amazon RDS for MySQL instance placed in the ISOLATED
# DB subnets. This is an AWS-managed database, so AWS handles the underlying
# host OS patching, engine installation, and infrastructure - while WE remain
# responsible for network placement, access control, encryption settings,
# credentials, and backups configuration.
#
# Key security properties:
#   * publicly_accessible = false  -> no public endpoint / IP
#   * lives in the DB subnet group (isolated subnets, no internet route)
#   * reachable ONLY from the app tier SG on 3306
#   * storage encrypted at rest
#   * master password generated by Terraform and stored in SSM SecureString,
#     never hardcoded or committed to Git
# ---------------------------------------------------------------------------

# ------------------------- Credentials (no secrets in code) ----------------
# Generate a strong random master password at apply time.
resource "random_password" "db" {
  length  = 20
  special = true
  # Exclude characters that are awkward in shell/URLs to keep the demo robust.
  override_special = "!#%*-_=+"
}

# Store the password in SSM Parameter Store as an encrypted SecureString. This
# is the single source of truth for the secret; the app reads it at runtime via
# its IAM role. Marked sensitive so Terraform never prints it in plan output.
resource "aws_ssm_parameter" "db_password" {
  name        = "/${var.project_name}/${var.environment}/db/password"
  description = "Master password for the RDS MySQL instance (generated by Terraform)"
  type        = "SecureString"
  value       = random_password.db.result

  tags = {
    Name = "${local.name_prefix}-db-password"
    Tier = "isolated-db"
  }
}

# ------------------------------- RDS instance ------------------------------
resource "aws_db_instance" "main" {
  identifier     = "${local.name_prefix}-mysql"
  engine         = "mysql"
  engine_version = var.db_engine_version
  instance_class = var.db_instance_class

  allocated_storage = var.db_allocated_storage
  storage_type      = "gp3"
  storage_encrypted = true # encryption at rest

  db_name  = var.db_name
  username = var.db_username
  password = random_password.db.result

  # Network isolation: private subnet group + app-only security group.
  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [aws_security_group.db.id]
  publicly_accessible    = false
  multi_az               = var.db_multi_az
  port                   = local.db_port

  # Backups: 7-day automated backups demonstrate the customer's responsibility
  # to configure data protection (AWS runs the backup machinery).
  backup_retention_period = 7

  # Student-demo friendliness: allow clean teardown without a final snapshot.
  # In production you would set these to protect data. Documented in README.
  skip_final_snapshot = true
  deletion_protection = false

  # Only apply engine minor-version upgrades in maintenance windows.
  auto_minor_version_upgrade = true

  tags = {
    Name = "${local.name_prefix}-mysql"
    Tier = "isolated-db"
  }
}
