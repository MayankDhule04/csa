# terraform.tfvars.example
# ---------------------------------------------------------------------------
# Copy this file to terraform.tfvars and adjust as needed:
#
#     cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is git-ignored so your personal values are never committed.
# NONE of these values are secrets - the DB password is generated by Terraform
# and stored in SSM, so there is nothing sensitive to put here.
# ---------------------------------------------------------------------------

# --- General ---
aws_region   = "us-east-1"
project_name = "cloudsec-pbl"
environment  = "dev"
owner        = "your-name"

# --- Networking ---
vpc_cidr           = "10.0.0.0/16"
az_count           = 2
single_nat_gateway = true # true = cheaper (1 NAT GW); false = 1 per AZ (resilient)

# --- Application tier ---
app_instance_type    = "t3.micro"
app_desired_capacity = 2
app_min_size         = 2
app_max_size         = 2

# --- Database tier ---
db_engine_version    = "8.0"
db_instance_class    = "db.t3.micro"
db_allocated_storage = 20
db_name              = "appdb"
db_username          = "appadmin"
db_multi_az          = false # true to demonstrate DB high availability (higher cost)

# --- Access control ---
# Tighten this to "YOUR.PUBLIC.IP/32" for a locked-down demo, or leave the
# default "0.0.0.0/0" to expose the public web tier to any client.
allowed_web_cidr = "0.0.0.0/0"
